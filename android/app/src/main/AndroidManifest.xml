<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 聊天/目录拉取/Git 授权/版本检查全部依赖网络 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      应用内更新:下载并校验过指纹的安装包要交给系统安装器。
      Android 8.0+ 还需用户在系统里单独允许「安装未知应用」,App 会先检查并把用户送过去。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      长任务前台保活:多轮 agent 任务(流式 + 工具循环)动辄几十秒到几分钟,
      切走或锁屏后没有前台服务的进程会被冻结/回收,回复就断在半截。
      dataSync 类型：本地处理对话数据,不上传用户数据到任何自有服务。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- API 33+ 的运行时权限:未授予时前台服务照常运行(任务不会断),只是通知不可见。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.freebuff.app.FreebuffApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Freebuff">
        <activity
            android:name="com.freebuff.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Freebuff">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          长任务前台服务:运行中挂一条低优先级常驻通知,结束时发一条可点回的完成通知。
          "通知权限被拒时前台服务仍然合法(通知只是不可见),任务不会因此中断。"
        -->
        <service
            android:name="com.freebuff.app.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!--
          更新包落在 cacheDir/update/(应用私有,外部存储读不到),
          只能经 content:// 交出去 —— 直接传文件路径给安装器在高版本上会被拒。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
